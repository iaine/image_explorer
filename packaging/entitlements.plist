<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only when signing with a Developer ID (CODESIGN_IDENTITY), which turns
  on Apple's hardened runtime. Python's ctypes/libffi needs writable+executable
  memory, which the hardened runtime blocks unless this entitlement is present.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
